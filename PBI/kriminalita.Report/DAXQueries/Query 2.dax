EVALUATE
	SELECTCOLUMNS(
		TOPN(
			100,
			'f_populace',
			'f_populace'[year],
			ASC
		),
		'f_populace'[year],
		'f_populace'[kod_obec],
		'f_populace'[narozeni],
		'f_populace'[zemreli],
		'f_populace'[pristehovali],
		'f_populace'[vystehovali],
		'f_populace'[prirustek_prirozeny],
		'f_populace'[prirustek_migracni],
		'f_populace'[prirustek_celkovy],
		'f_populace'[populace]
	)
	ORDER BY 'f_populace'[year] ASC
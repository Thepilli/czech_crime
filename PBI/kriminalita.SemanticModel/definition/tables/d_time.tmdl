	column HourBand6
		lineageTag: 8ef9ba3c-3ae4-41ff-8851-1a22bdd83866
		isNameInferred
		sourceColumn: [HourBand6]
		sortByColumn: HourBand6Sort

	partition d_time = calculated
		mode: import
		source =
				
				VAR BaseTime =
				    GENERATESERIES ( 0, 1439, 1 )
				VAR AddParts =
				    ADDCOLUMNS (
				        BaseTime,
				        "TimeValue", TIME ( 0, [Value], 0 ),
				        "HourNumber", INT ( [Value] / 60 ),
				        "MinuteNumber", MOD ( [Value], 60 ),
				        "HourStart", TIME ( 0, INT ( [Value] / 60 ) * 60, 0 ),
				        "MinuteStart15", TIME ( 0, INT ( [Value] / 15 ) * 15, 0 ),
				        "MinuteStart30", TIME ( 0, INT ( [Value] / 30 ) * 30, 0 )
				    )
				VAR AddBands =
				    ADDCOLUMNS (
				        AddParts,
				        "HourBandSort",
				            SWITCH (
				                TRUE (),
				                [HourNumber] <= 5, 1,
				                [HourNumber] <= 11, 2,
				                [HourNumber] <= 17, 3,
				                4
				            ),
				        "HourBand6Sort", INT ( [HourNumber] / 4 ) + 1
				    )
				RETURN
				    SELECTCOLUMNS (
				        AddBands,
				        "TimeKey", [Value],
				        "Time", [TimeValue],
				        "HourNumber", [HourNumber],
				        "Hour", FORMAT ( [TimeValue], "HH:00" ),
				        "MinuteNumber", [MinuteNumber],
				        "Minute", FORMAT ( [TimeValue], "HH:mm" ),
				        "HourStart", [HourStart],
				        "15MinuteBand", FORMAT ( [MinuteStart15], "HH:mm" ),
				        "30MinuteBand", FORMAT ( [MinuteStart30], "HH:mm" ),
				        "HourBandSort", [HourBandSort],
				        "HourBand",
				            SWITCH (
				                [HourBandSort],
				                1, "00-05 Night",
				                2, "06-11 Morning",
				                3, "12-17 Afternoon",
				                "18-23 Evening"
				            ),
				        "HourBand6Sort", [HourBand6Sort],
				        "HourBand6",
				            FORMAT ( ( [HourBand6Sort] - 1 ) * 4, "00" ) & "-"
				                & FORMAT ( [HourBand6Sort] * 4 - 1, "00" )
				    )

	annotation TabularEditor_TableGroup = DIMs


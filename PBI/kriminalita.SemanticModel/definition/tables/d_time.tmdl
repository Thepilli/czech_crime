	partition d_time = calculated
		mode: import
		source =
				VAR BaseTime =
				    GENERATESERIES ( 0, 1439, 1 )
				RETURN
				    SELECTCOLUMNS (
				        ADDCOLUMNS (
				            BaseTime,
				            "TimeValue", TIME ( 0, [Value], 0 ),
				            "HourNumber", INT ( [Value] / 60 ),
				            "MinuteNumber", MOD ( [Value], 60 ),
				            "HourStart", TIME ( 0, INT ( [Value] / 60 ) * 60, 0 ),
				            "MinuteStart15", TIME ( 0, INT ( [Value] / 15 ) * 15, 0 ),
				            "MinuteStart30", TIME ( 0, INT ( [Value] / 30 ) * 30, 0 )
				        ),
				        "TimeKey", [Value],
				        "Time", [TimeValue],
				        "HourNumber", [HourNumber],
				        "Hour", FORMAT ( [TimeValue], "HH:00" ),
				        "MinuteNumber", [MinuteNumber],
				        "Minute", FORMAT ( [TimeValue], "HH:mm" ),
				        "HourStart", [HourStart],
				        "15MinuteBand", FORMAT ( [MinuteStart15], "HH:mm" ),
				        "30MinuteBand", FORMAT ( [MinuteStart30], "HH:mm" )
				    )

	annotation TabularEditor_TableGroup = DIMs


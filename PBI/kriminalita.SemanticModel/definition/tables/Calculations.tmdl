	measure 'Crude Birth Rate (per 1k)' =
			AVERAGEX(
			    VALUES( mv_d_date[Year] ),
			    VAR _y = mv_d_date[Year]
			    RETURN
			        DIVIDE(
			            CALCULATE(
			                [SUM of narozeni],
			                f_populace[year] = _y
			            ),
			            CALCULATE(
			                [SUM of populace],
			                f_populace[year] = _y
			            )
			        )
			            * 1000
			)
		formatString: #,0.0
		displayFolder: Demographics\Rates
		lineageTag: c4a16660-3358-48a7-9e57-f14e89108b7a

	measure 'Crude Death Rate (per 1k)' =
			AVERAGEX(
			    VALUES( mv_d_date[Year] ),
			    VAR _y = mv_d_date[Year]
			    RETURN
			        DIVIDE(
			            CALCULATE(
			                [SUM of zemreli],
			                f_populace[year] = _y
			            ),
			            CALCULATE(

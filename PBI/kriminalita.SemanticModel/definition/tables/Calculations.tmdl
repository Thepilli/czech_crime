	measure 'Quadrant Color' = Common.QuadrantColor([Incidents by primary type],[Crime rate],mv_d_uzemi[název_kraje_short])
		displayFolder: Technical Measures
		lineageTag: d97c5fa8-1d71-4f5b-9739-03189f42f8ed

	measure selected_date_range_SVG =
			VAR __minCurr = MIN( mv_d_date[Date] )
			VAR __maxCurr = MAX( mv_d_date[Date] )
			VAR __pmDates  = DATEADD( mv_d_date[Date], -1, MONTH )
			VAR __minPM    = MINX( __pmDates, mv_d_date[Date] )
			VAR __maxPM    = MAXX( __pmDates, mv_d_date[Date] )
			VAR __pyDates  = SAMEPERIODLASTYEAR( mv_d_date[Date] )
			VAR __minPY    = MINX( __pyDates, mv_d_date[Date] )
			VAR __maxPY    = MAXX( __pyDates, mv_d_date[Date] )
			
			VAR __actual = "Actual: " & FORMAT(__minCurr,"dd.mm.yyyy") & "–" & FORMAT(__maxCurr,"dd.mm.yyyy")
			VAR __pm     = "PM:     " & FORMAT(__minPM,  "dd.mm.yyyy") & "–" & FORMAT(__maxPM,  "dd.mm.yyyy")
			VAR __py     = "PY:     " & FORMAT(__minPY,  "dd.mm.yyyy") & "–" & FORMAT(__maxPY,  "dd.mm.yyyy")
			
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 55' preserveAspectRatio='xMidYMid meet'>" &
			"<style>text{font-family:Segoe UI,Arial,sans-serif;font-size:12px;fill:#FFFFFF;text-anchor:middle;}</style>" &
			"<text x='100' y='12'>" & __actual & "</text>" &
			"<text x='100' y='28'>" & __pm     & "</text>" &
			"<text x='100' y='44'>" & __py     & "</text>" &
			"</svg>"
		displayFolder: Technical Measures
		lineageTag: 5de35f8d-6301-4993-b132-f637faea4a57

	measure Zero = 0
		displayFolder: Technical Measures
		lineageTag: caf2d7a2-29b5-4029-a747-d47c9c46c63d

	measure 'Zero 2' = 0
		displayFolder: Technical Measures
		lineageTag: 20e5f703-1cca-4dc0-a7cc-e0455acaf450

	measure One = 1
		displayFolder: Technical Measures
		lineageTag: b90bb1e1-fb1a-4354-a754-2c5d840337a0

	measure 'Incidents by primary type' =
			CALCULATE(
			    [COUNTROWS of mv_f_crime ],
			    USERELATIONSHIP( mv_f_crime[primary_type], d_type[type_code] )
			)
		lineageTag: 39c511e7-fe0e-4a6d-aeaa-e281a4a7fcbf

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'hourband6 color' =
			SWITCH(
			    SELECTEDVALUE( d_time[HourBand6] ),
			    "00-03", "#16255C",
			    "04-07", "#2A5FA5",
			    "08-11", "#5E9BC9",
			    "12-15", "#EFA13C",
			    "16-19", "#D2601F",
			    "20-23", "#8B1A1A"
			)
		displayFolder: Technical Measures
		lineageTag: 5db4dc69-50a8-45a8-8f3a-b87e1bb1a005

	measure 'Intro Headline' =
			VAR Inc  = CALCULATE ( [Incidents by primary type], REMOVEFILTERS () )
			VAR Rate = CALCULATE ( [Crime rate], REMOVEFILTERS () )
			VAR Solv = CALCULATE ( [Incidents Solved (%)], REMOVEFILTERS () )
			RETURN
			    FORMAT ( Inc, "#,0" ) & " incidents  ·  "
			        & FORMAT ( Rate, "0.00" ) & " /1000 ppl  ·  "
			        & FORMAT ( Solv, "0.0%" ) & " solved  ·  "
			        & [Data Coverage Text]
		displayFolder: Technical Measures
		lineageTag: 144109fb-5d90-49e3-8f37-b0db69dcc915

	measure 'Data Coverage Text' =
			VAR MinD = CALCULATE ( MIN ( mv_f_crime[CrimeDate]), REMOVEFILTERS () )
			VAR MaxD = CALCULATE ( MAX ( mv_f_crime[CrimeDate] ), REMOVEFILTERS () )
			RETURN
			    FORMAT ( MinD, "MMM yyyy" ) & " – " & FORMAT ( MaxD, "MMM yyyy" )
		displayFolder: Technical Measures
		lineageTag: 7ca77961-637b-474f-939e-84ab9efe023f

	column Value
		formatString: 0
		lineageTag: 8dad4fd8-1eb4-477c-86ea-327be38d01cf
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Calculations = calculated
		mode: import
		source = { 0 }

	annotation PBI_Id = 0eba8c94c766459183d11d6f30f2501a


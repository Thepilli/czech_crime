			        CurrentValue,
			        BLANK( )
			    )
		formatString: #,0.0
		displayFolder: SelfService
		lineageTag: 2c7a26d2-4004-4f59-889d-a1ed7877e854

	measure 'Self Service Measure Title Range' =
			VAR __KPI =
			    SELECTEDVALUE(
			        H_SelfServiceMeasures[KPIName],
			        "not selected"
			    )
			VAR _lastDate =
			    CALCULATE( MAX( mv_d_date[Date] ) )
			VAR _firstDate =
			    CALCULATE( MIN( mv_d_date[Date] ) )
			VAR _yearMax = FORMAT( _lastDate, "YYYY" )
			VAR _monthMax = FORMAT( _lastDate, "mmm" )
			VAR _yearMin = FORMAT( _firstDate, "YYYY" )
			VAR _monthMin = FORMAT( _firstDate, "mmm" )
			VAR _dateMax = _monthMax & ", " & _yearMax
			VAR _dateMin = _monthMin & ", " & _yearMin
			VAR _date = _dateMin & " - " & _dateMax
			RETURN
			    __KPI & " for: " & _date
		displayFolder: SelfService
		lineageTag: 1db7be03-56f7-43a6-a6c4-da3790acf53f


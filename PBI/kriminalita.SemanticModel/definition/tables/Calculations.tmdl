	measure 'Population Change' =
			[Population (end of period)]
			    - [Population (start of period)]
		formatString: #,0
		displayFolder: Demographics\Growth
		lineageTag: 6690218a-0cac-48e8-9e1d-d8a07a4e5862

	measure 'Population Change %' =
			DIVIDE(
			    [Population Change],
			    [Population (start of period)]
			)
		formatString: 0.0%
		displayFolder: Demographics\Growth
		lineageTag: 38296b74-c577-4fd3-b931-6bd6c26de25a

	measure 'Population YoY' =
			VAR _cur = [Population (end of period)]
			VAR _prev = [Population (prev year)]
			RETURN
			    IF( NOT ISBLANK( _prev ), _cur - _prev )
		formatString: #,0
		displayFolder: Demographics\Growth
		lineageTag: 89c03e99-259e-41d7-93d2-8f78231ff248

	measure 'Population YoY %' =
			DIVIDE(
			    [Population YoY],
			    [Population (prev year)]
			)
		formatString: 0.0%
		displayFolder: Demographics\Growth
		lineageTag: 295a61b4-0533-4796-a9ec-283c5dcf4dc2

	measure 'Population CAGR %' =
			VAR _start = [Population (start of period)]
			VAR _end = [Population (end of period)]
			VAR _years =
			    MAX( mv_d_date[Year] ) - MIN( mv_d_date[Year] )
			RETURN
			    IF(
			        _years > 0 && _start > 0,
			        ( _end / _start ) ^ ( 1 / _years ) - 1
			    )
		formatString: 0.0%
		displayFolder: Demographics\Growth
		lineageTag: b9222834-6101-492a-aa2a-484fa8d5aa51


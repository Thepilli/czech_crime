	measure 'Max Current Value' =
			VAR Vals =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                mv_d_date,
			                mv_d_date[Month],
			                mv_d_date[MonthLetter]
			            ),
			            "@Measure", [Self Service Measure]
			        ),
			        ALLSELECTED( )
			    )
			VAR HighestValue = MAXX( Vals, [@Measure] )
			VAR CurrentValue = [Self Service Measure]
			RETURN
			    IF(
			        CurrentValue = HighestValue,
			        CurrentValue,
			        BLANK( )
			    )
		formatString: #,0.0
		displayFolder: SelfService
		lineageTag: da12b9e2-845e-4d97-8cba-8f8e5f72e2bb

	measure 'Min Current Value' =
			VAR Vals =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            SUMMARIZE(
			                mv_d_date,
			                mv_d_date[Month],
			                mv_d_date[MonthLetter]
			            ),
			            "@Measure", [Self Service Measure]
			        ),
			        ALLSELECTED( )
			    )
			VAR LowestValue = MINX( Vals, [@Measure] )
			VAR CurrentValue = [Self Service Measure]
			RETURN
			    IF(
			        CurrentValue = LowestValue,
			        CurrentValue,
			        BLANK( )
			    )
		formatString: #,0.0
		displayFolder: SelfService
		lineageTag: 2c7a26d2-4004-4f59-889d-a1ed7877e854


	measure 'Crime rate (annualized)' =
			VAR _days = DISTINCTCOUNT( mv_d_date[Date] )
			RETURN
			    DIVIDE(
			        [Incidents by primary type]
			            * DIVIDE( 365.25, _days ),
			        [Avg Annual Population]
			    )
			        * 1000

table Calculations
	lineageTag: 22892283-e340-4ce0-a675-b5d8f6e51281

	measure Incidents = COUNTROWS( mv_f_crime )
		formatString: #,0
		lineageTag: 33fcf400-73b6-49bd-8ef4-10e7482e67ab

	measure 'Incidents by primary type' =
			CALCULATE(
			    [Incidents],
			    USERELATIONSHIP( mv_f_crime[primary_type], d_type[type_code] )
			)
		formatString: #,0
		lineageTag: 39c511e7-fe0e-4a6d-aeaa-e281a4a7fcbf

	measure 'Incident share' =
			DIVIDE(
			    [Incidents],
			    CALCULATE( [Incidents], REMOVEFILTERS( d_type ) )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 22bb864d-4a10-41dd-a674-f310f7989590

	measure 'Incident share by primary type' =
			DIVIDE(
			    [Incidents by primary type],
			    CALCULATE(
			        [Incidents by primary type],
			        REMOVEFILTERS( d_type )
			    )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 02f8d496-077c-4b55-9ad8-2a4fa8a87662

	measure 'Icon SVG' =
			VAR _Color = "1f2937"  -- icon color WITHOUT the # (icons ship white; this recolors them). e.g. 1f2937 dark, ffffff white, e81123 red
			VAR _Id = SELECTEDVALUE( d_type[category_code] )
			VAR _Svg =
			    SWITCH(
			        _Id,

	measure 'Crime rate (daily avg)' =
			VAR _days = DISTINCTCOUNT( mv_d_date[Date] )
			RETURN
			    DIVIDE(
			        DIVIDE( [Incidents by primary type], _days ),
			        [Avg Annual Population]
			    )
			        * 1000

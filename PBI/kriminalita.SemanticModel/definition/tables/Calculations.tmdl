	measure 'Population (start of period)' =
			VAR _y = MIN( mv_d_date[Year] )
			RETURN
			    CALCULATE(
			        [SUM of populace],
			        f_populace[year] = _y
			    )
		formatString: #,0
		displayFolder: Demographics\Population
		lineageTag: b2ef2206-7423-4bb6-8de2-967d192fa9ea

	measure 'Population (end of period)' =
			VAR _y = MAX( mv_d_date[Year] )
			RETURN

table Calculations
	lineageTag: 22892283-e340-4ce0-a675-b5d8f6e51281

	measure 'COUNTROWS of mv_f_crime ' = COUNTROWS( mv_f_crime )
		formatString: #,0
		displayFolder: Aggregations
		lineageTag: 33fcf400-73b6-49bd-8ef4-10e7482e67ab

	measure 'Incidents by primary type' =
			CALCULATE(
			    [COUNTROWS of mv_f_crime ],
			    USERELATIONSHIP( mv_f_crime[primary_type], d_type[type_code] )
			)
		lineageTag: 39c511e7-fe0e-4a6d-aeaa-e281a4a7fcbf

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'Incident share' =
			DIVIDE(
			    [COUNTROWS of mv_f_crime ],
			    CALCULATE(
			        [COUNTROWS of mv_f_crime ],
			        REMOVEFILTERS( d_type )
			    )
			)
		lineageTag: 22bb864d-4a10-41dd-a674-f310f7989590

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'Incident share by primary type' =
			DIVIDE(
			    [Incidents by primary type],
			    CALCULATE(
			        [Incidents by primary type],
			        REMOVEFILTERS( d_type )
			    )
			)
		lineageTag: 02f8d496-077c-4b55-9ad8-2a4fa8a87662

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'Icon SVG' =
			VAR _Color = "1f2937"   -- 1f2937 dark, ffffff white, e81123 red
			VAR _Svg = SELECTEDVALUE( H_Icons[svg] )
			RETURN
			    IF(
			        ISBLANK( _Svg ),
			        BLANK( ),
			        "data:image/svg+xml;utf8,"
			            & SUBSTITUTE( _Svg, "%23ffffff", "%23" & _Color )
			    )
		displayFolder: Technical Measures
		lineageTag: b9b9f236-71ac-482a-80cc-433db4c86309
		dataCategory: ImageUrl

	measure 'Crime rate' =
			//DIVIDE(
			//    [Incidents by primary type],
			//    [Avg Annual Population]
			//)
			//    * 1000
			// Incidents per 1,000 residents, annualized so any period (month/quarter/YTD/year)
			// is expressed on the same "per year" scale. Denominator is a stock (population),
			// applied uniformly across the period.
			VAR _incidents = [Incidents by primary type]
			// Count only elapsed days that actually have data, so a partial current year
			// annualizes on elapsed days rather than a full 365 (avoids understating the run-rate).
			VAR _lastDataDate = MAX( mv_f_crime[CrimeDate] )
			VAR _days =
			    CALCULATE(
			        DISTINCTCOUNT( mv_d_date[Date] ),
			        KEEPFILTERS( mv_d_date[Date] <= _lastDataDate )
			    )
			VAR _annualFactor = DIVIDE( 365.25, _days )
			VAR _population = [Avg Annual Population]   -- swap to [Avg Annual Population] once f_populace_year exists (year-correct YoY)
			RETURN
			    DIVIDE( _incidents * _annualFactor, _population )
			        * 1000
		lineageTag: 7252513d-e01a-4fa9-a180-7889c4f4fb63

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'Avg Annual Population' =
			AVERAGEX(
			    VALUES( mv_d_date[Year] ),
			    VAR _y = mv_d_date[Year]
			    RETURN
			        CALCULATE(
			            [SUM of populace],
			            f_populace[year] = _y
			        )
			)
		lineageTag: ca0d1fbf-772f-46e5-b45c-626129c5e0c0

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )


			RETURN
			    IF(
			        ISBLANK( _Svg ),
			        BLANK( ),
			        "data:image/svg+xml;utf8,"
			            & SUBSTITUTE( _Svg, "%23ffffff", "%23" & _Color )
			    )
		lineageTag: b9b9f236-71ac-482a-80cc-433db4c86309
		dataCategory: ImageUrl

	measure 'Crime rate' =
			//DIVIDE(
			//    [Incidents by primary type],
			//    [Avg Annual Population]
			//)
			//    * 1000
			
			// Incidents per 1,000 residents, annualized so any period (month/quarter/YTD/year)
			// is expressed on the same "per year" scale. Denominator is a stock (population),
			// applied uniformly across the period.
			VAR _incidents = [Incidents by primary type]
			// Count only elapsed days that actually have data, so a partial current year
			// annualizes on elapsed days rather than a full 365 (avoids understating the run-rate).
			VAR _lastDataDate = MAX( mv_f_crime[CrimeDate] )
			VAR _days =
			    CALCULATE(
			        DISTINCTCOUNT( mv_d_date[Date] ),
			        KEEPFILTERS( mv_d_date[Date] <= _lastDataDate )
			    )
			VAR _annualFactor = DIVIDE( 365.25, _days )
			VAR _population = [Avg Annual Population]   -- year-matched, semi-additive over time
			RETURN
			    DIVIDE( _incidents * _annualFactor, _population )
			        * 1000
		formatString: #,0.0
		lineageTag: 7252513d-e01a-4fa9-a180-7889c4f4fb63

	measure 'Avg Annual Population' =
			AVERAGEX(
			    VALUES( mv_d_date[Year] ),
			    VAR _y = mv_d_date[Year]
			    RETURN
			        CALCULATE(
			            [SUM of populace],
			            f_populace[year] = _y
			        )
			)
		formatString: #,0
		lineageTag: ca0d1fbf-772f-46e5-b45c-626129c5e0c0


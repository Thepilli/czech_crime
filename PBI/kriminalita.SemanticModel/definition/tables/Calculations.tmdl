	measure 'Population || ALL(%)' =
			DIVIDE(
			    [Avg Annual Population],
			    CALCULATE(
			        [Avg Annual Population],
			        REMOVEFILTERS( mv_d_uzemi[název_kraje] )
			    )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Demographics\Population
		lineageTag: ab6be45e-57fb-4c94-bc8f-da9a66d51c94

	measure 'Avg Annual Population sparkline' =
			VAR BarColour  = "rgb(140,164,240)"
			VAR TickColour = "rgb(237,137,54)"
			// --- layout knobs ---
			VAR ViewW    = 150
			VAR ViewH    = 50
			VAR Pad      = 3
			VAR Fill     = 0.55
			VAR MaxBarW  = 26                          // cap so 2-3 years don't look like blocks
			VAR LabelSize = 8
			// --- axis: all years, slicer-independent ---
			VAR AllYears =
			    CALCULATETABLE (
			        VALUES ( mv_d_date[Year] ),
			        REMOVEFILTERS ( mv_d_date )
			    )
			VAR WithVals =
			    ADDCOLUMNS (
			        AllYears,
			        "@CY",
			            VAR y = mv_d_date[Year]
			            RETURN CALCULATE (
			                [Self Service Measure],
			                REMOVEFILTERS ( mv_d_date ),
			                mv_d_date[Year] = y
			            ),
			        "@PY",
			            VAR y = mv_d_date[Year]
			            RETURN CALCULATE (
			                [Self Service Measure PY],
			                REMOVEFILTERS ( mv_d_date ),
			                mv_d_date[Year] = y
			            )
			    )
			// drop empty years (dim usually extends past the fact data)
			VAR Populated = FILTER ( WithVals, NOT ISBLANK ( [@CY] ) || NOT ISBLANK ( [@PY] ) )
			VAR Ranked =
			    ADDCOLUMNS (
			        Populated,
			        "@Rank", RANKX ( Populated, mv_d_date[Year], , ASC )
			    )
			VAR N     = COUNTROWS ( Ranked )
			VAR MaxV  = MAX ( MAXX ( Ranked, [@CY] ), MAXX ( Ranked, [@PY] ) )
			VAR SlotW = DIVIDE ( ViewW, N )
			VAR BarW  = MIN ( SlotW * Fill, MaxBarW )
			VAR Geo =
			    ADDCOLUMNS (
			        Ranked,
			        "@X",   ROUND ( ( [@Rank] - 1 ) * SlotW + ( SlotW - BarW ) / 2, 2 ),
			        "@H",   ROUND ( ( ViewH - Pad ) * DIVIDE ( [@CY], MaxV, 0 ), 2 ),
			        "@PYy", ROUND ( ViewH - ( ViewH - Pad ) * DIVIDE ( [@PY], MaxV, 0 ), 2 )
			    )
			VAR Bars =
			    CONCATENATEX (
			        Geo,
			        "<rect x='" & [@X] & "' y='" & ROUND ( ViewH - [@H], 2 )
			            & "' width='" & ROUND ( BarW, 2 ) & "' height='" & [@H]
			            & "' rx='1' fill='" & BarColour & "'/>",
			        "", [@Rank], ASC
			    )
			VAR Ticks =
			    CONCATENATEX (
			        Geo,
			        "<line x1='" & ROUND ( [@X] - 0.5, 2 ) & "' y1='" & [@PYy]
			            & "' x2='" & ROUND ( [@X] + BarW + 0.5, 2 ) & "' y2='" & [@PYy]
			            & "' stroke='" & TickColour & "' stroke-width='2'/>",
			        "", [@Rank], ASC
			    )
			VAR Labels =
			    CONCATENATEX (
			        Geo,
			        "<text x='" & ROUND ( [@X] + BarW / 2, 2 ) & "' y='" & ViewH + LabelSize + 2 & "'>"
			            & mv_d_date[Year] & "</text>",
			        "", [@Rank], ASC
			    )
			VAR SVG =
			    "data:image/svg+xml;utf8," &
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & ViewW & " " & ( ViewH + LabelSize + 4 ) & "'>" &
			    Bars & Ticks &
			    "<g font-family='Segoe UI,Arial,sans-serif' font-size='" & LabelSize &
			    "' text-anchor='middle' fill='rgb(150,158,170)'>" & Labels & "</g>" &
			    "</svg>"
			RETURN
			    SVG
		displayFolder: Demographics\Population
		lineageTag: 7a607274-a98a-4366-aee0-4e0d257ce9df
		dataCategory: ImageUrl


			                mv_d_date[MonthLetter]
			            ),
			            "@Measure", [Self Service Measure]
			        ),
			        ALLSELECTED( )
			    )
			VAR LowestValue = MINX( Vals, [@Measure] )
			VAR CurrentValue = [Self Service Measure]
			RETURN
			    IF(

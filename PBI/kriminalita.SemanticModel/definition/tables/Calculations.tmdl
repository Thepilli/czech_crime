	measure 'Top Category by Incidents' =
			VAR _byCategory =
			    ADDCOLUMNS(
			        VALUES( d_type[category_name] ),
			        "@inc", [Incidents by primary type]
			    )
			VAR _top = TOPN( 1, _byCategory, [@inc], DESC )
			RETURN
			    IF(
			        NOT ISBLANK( [Incidents by primary type] ),   -- nothing in context → blank, not a stray label
			        CONCATENATEX( _top, d_type[category_name], ", " )   -- comma-joins on ties
			    )
		displayFolder: Labels
		lineageTag: 146686e2-d0ec-4f2e-ae26-293288935c4c

	measure 'Top Category Incidents' =
			-- the winning count, to show beside the name
			MAXX(
			    VALUES( d_type[category_name] ),
			    [Incidents by primary type]
			)
		formatString: #,0
		displayFolder: Labels
		lineageTag: 5d12c324-d35b-4faf-a576-157d3ad13d6f

	measure 'Top Category Incidents || ALL(%)' =
			DIVIDE(
			    [Top Category Incidents],
			    [Incidents by primary type]
			)
		displayFolder: Labels
		lineageTag: 850d6c92-243e-4111-98fc-2d5e46ecc09c

		formatStringDefinition = Common.FormatString( SELECTEDMEASURE( ), SELECTEDMEASURENAME( ) )

	measure 'Incidents by primary type sparkline' = Common.SVG.sparkline( [Incidents by primary type] , [Incidents by primary type YoY(%)] , , TRUE )
		lineageTag: 7581cfb1-a2d5-42d0-98c8-ca6729108611
		dataCategory: ImageUrl

	measure Subtitle =
			VAR _lastDate = CALCULATE( MAX( mv_d_date[Date] ) )
			VAR _firstDate = CALCULATE( MIN( mv_d_date[Date] ) )
			VAR _yearMax = FORMAT( _lastDate, "YYYY" )
			VAR _monthMax = FORMAT( _lastDate, "mmm" )
			VAR _yearMin = FORMAT( _firstDate, "YYYY" )
			VAR _monthMin = FORMAT( _firstDate, "mmm" )
			VAR _dateMax = _monthMax & ", " & _yearMax
			VAR _dateMin = _monthMin & ", " & _yearMin
			VAR _date = _dateMin & " - " & _dateMax
			RETURN
			    IF(
			        HASONEVALUE( mv_d_date[yearmonth] ),
			        "For: " & _dateMax,
			        "For: " & _date
			    )
		displayFolder: Technical Measures
		lineageTag: 5854923d-6e25-4c5e-a3e4-1bfe7fd2d089

	measure Title =
			VAR _lastDate = CALCULATE( MAX( mv_d_date[Date] ) )
			VAR _firstDate = CALCULATE( MIN( mv_d_date[Date] ) )
			VAR _yearMax = FORMAT( _lastDate, "YYYY" )
			VAR _monthMax = FORMAT( _lastDate, "mmm" )
			VAR _yearMin = FORMAT( _firstDate, "YYYY" )
			VAR _monthMin = FORMAT( _firstDate, "mmm" )
			VAR _dateMax = _monthMax & ", " & _yearMax
			VAR _dateMin = _monthMin & ", " & _yearMin
			VAR _date = _dateMin & " - " & _dateMax
			RETURN
			    IF(
			        HASONEVALUE( mv_d_date[yearmonth] ),
			        "Overview for: " & _dateMax,
			        "Overview for: " & _date
			    )
		displayFolder: Technical Measures
		lineageTag: edf38157-c007-4678-8f06-62a4394063ee

	measure 'Top Category by Incident Color' =
			VAR _byCategory =
			    ADDCOLUMNS(
			        VALUES( d_type[category_name] ),
			        "@inc", [Incidents by primary type],
			        "@color", [Icon color]
			    )
			VAR _top = TOPN( 1, _byCategory, [@inc], DESC )
			RETURN
			    IF(
			        NOT ISBLANK( [Incidents by primary type] ),
			        MAXX( _top, [@color] )
			    )
		displayFolder: Labels
		lineageTag: eea8c621-dcde-4e8a-8b3f-adc332cdcd1e

	measure 'Population || ALL(%)' =
			DIVIDE(
			    [Avg Annual Population],
